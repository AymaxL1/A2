{
  "note": "金标报文样本(手写,非生成)。TS 侧 bun test 与 Swift 侧手写 Codable(09 票)对同一批样本编解码,契约漂移即门禁报警。valid 样本必须解析通过且往返后逐字段不变;invalid 样本必须被拒。",
  "protocol": 1,
  "samples": [
    {
      "file": "request-status-get.json",
      "schema": "RequestEnvelope",
      "kind": "valid",
      "why": "最小请求:只有 v/id/op 三个必填字段"
    },
    {
      "file": "request-with-params.json",
      "schema": "RequestEnvelope",
      "kind": "valid",
      "why": "带 params 的请求:params 是任意 JSON 对象"
    },
    {
      "file": "response-status-ok.json",
      "schema": "ResponseEnvelope",
      "kind": "valid",
      "why": "成功包封:ok=true 带 result,不带 error"
    },
    {
      "file": "status-result.json",
      "schema": "StatusResult",
      "kind": "valid",
      "why": "status.get 的 result 载荷本体"
    },
    {
      "file": "response-daemon-unreachable.json",
      "schema": "ResponseEnvelope",
      "kind": "valid",
      "why": "拒绝即指引:失败包封带 guidance(summary + 精确命令步骤 + context 事实)"
    },
    {
      "file": "response-unknown-op.json",
      "schema": "ResponseEnvelope",
      "kind": "valid",
      "why": "失败包封的最小形态:只有 code/message/detail,没有 guidance"
    },
    {
      "file": "guidance.json",
      "schema": "Guidance",
      "kind": "valid",
      "why": "指引载荷本体:步骤可以只有说明、没有命令"
    },
    {
      "file": "request-capabilities-call.json",
      "schema": "RequestEnvelope",
      "kind": "valid",
      "why": "能力调用请求:params 里 capability + input(按参数名取值的 JSON 对象)"
    },
    {
      "file": "capability-descriptor.json",
      "schema": "CapabilityDescriptor",
      "kind": "valid",
      "why": "能力 manifest:风险档 + 参数声明(含可选参数与 allowedValues 取值域)"
    },
    {
      "file": "capability-list-result.json",
      "schema": "CapabilityListResult",
      "kind": "valid",
      "why": "capabilities.list 的 result:含一条无入参的 dangerous 能力"
    },
    {
      "file": "capability-describe-result.json",
      "schema": "CapabilityDescribeResult",
      "kind": "valid",
      "why": "capabilities.describe 的 result:单条 manifest 包一层 descriptor"
    },
    {
      "file": "capability-call-result.json",
      "schema": "CapabilityCallResult",
      "kind": "valid",
      "why": "capabilities.call 的 result:capability 回填 + 能力自己的 output"
    },
    {
      "file": "response-confirmation-unavailable.json",
      "schema": "ResponseEnvelope",
      "kind": "valid",
      "why": "dangerous 默拒(fail-closed)的完整报文形状 —— 08 票补确认器时本形状不变"
    },
    {
      "file": "version-result.json",
      "schema": "VersionResult",
      "kind": "valid",
      "why": "a2 version --json 的 result:版本号 + 本 bin 说的线协议版本"
    },
    {
      "file": "help-result.json",
      "schema": "HelpResult",
      "kind": "valid",
      "why": "a2 help --json 的 result:帮助文本本身(机读面也不留散文空洞)"
    },
    {
      "file": "invalid-request-missing-op.json",
      "schema": "RequestEnvelope",
      "kind": "invalid",
      "why": "缺必填 op"
    },
    {
      "file": "invalid-request-wrong-protocol.json",
      "schema": "RequestEnvelope",
      "kind": "invalid",
      "why": "协议版本不是 1"
    },
    {
      "file": "invalid-response-ok-without-result.json",
      "schema": "ResponseEnvelope",
      "kind": "invalid",
      "why": "ok=true 却没有 result"
    },
    {
      "file": "invalid-response-error-missing-message.json",
      "schema": "ResponseEnvelope",
      "kind": "invalid",
      "why": "error 缺 message(机器读 code、人读 message,两者都必填)"
    },
    {
      "file": "invalid-guidance-empty-steps.json",
      "schema": "Guidance",
      "kind": "invalid",
      "why": "指引必须至少给出一步 —— 空指引等于没指引"
    },
    {
      "file": "invalid-capability-descriptor-unknown-risk.json",
      "schema": "CapabilityDescriptor",
      "kind": "invalid",
      "why": "风险档不在 safe/normal/dangerous 三档内 —— 分级是仲裁的输入,不许有第四档"
    },
    {
      "file": "invalid-capability-call-result-missing-output.json",
      "schema": "CapabilityCallResult",
      "kind": "invalid",
      "why": "调用成功却没有 output:成功就必须有结果,哪怕是 null"
    },
    {
      "file": "invalid-version-result-protocol-drift.json",
      "schema": "VersionResult",
      "kind": "invalid",
      "why": "protocol 不是本版协议号:版本报文自己就得对得上号"
    }
  ]
}
