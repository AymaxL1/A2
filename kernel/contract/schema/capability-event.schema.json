      "type": "string",
      "minLength": 1
    },
    "risk": {
      "type": "string",
      "enum": [
        "safe",
        "normal",
        "dangerous"
      ]
    },
    "output": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": [
    "capability",
    "risk",
    "output"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
