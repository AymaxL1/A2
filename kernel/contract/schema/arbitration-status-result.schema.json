{
  "title": "ArbitrationStatusResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state": {
      "type": "object",
      "properties": {
        "confirmerPresent": {
          "type": "boolean"
        },
        "confirmers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "subscribers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "pending": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "risk": {
                "type": "string",
                "enum": [
                  "safe",
                  "normal",
                  "dangerous"
                ]
              },
              "requestedAt": {
                "type": "string",
                "minLength": 1
              },
              "expiresAt": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "capability",
              "risk",
              "requestedAt",
              "expiresAt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "confirmerPresent",
        "confirmers",
        "subscribers",
        "timeoutMs",
        "pending"
      ],
      "additionalProperties": false
    },
    "logPath": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "requested",
              "approved",
              "denied",
              "timed_out",
              "unavailable",
              "downgraded",
              "cancelled",
              "confirmer_joined",
              "confirmer_left",
              "subscriber_joined",
              "subscriber_left",
              "peer_rejected",
              "peer_unverified",
              "backpressure_dropped",
              "plugin_added",
              "plugin_removed"
            ]
          },
          "capability": {
            "type": "string"
          },
          "confirmation": {
            "type": "string"
          },
          "client": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "confirm-agent",
                  "subscriber"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "uid": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "at",
          "action"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "state",
    "logPath",
    "events"
  ],
  "additionalProperties": false
}
