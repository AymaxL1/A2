{
  "title": "ProxyStatusResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "running": {
      "type": "boolean"
    },
    "apiReachable": {
      "type": "boolean"
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "enum": [
            "a2",
            "foreign"
          ]
        },
        "controller": {
          "type": "string",
          "minLength": 1
        },
        "managed": {
          "type": "boolean"
        },
        "configPath": {
          "type": "string"
        }
      },
      "required": [
        "owner",
        "controller",
        "managed"
      ],
      "additionalProperties": false
    },
    "version": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "mixedPort": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "node": {
      "type": "string"
    },
    "systemProxy": {
      "type": "object",
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "takenOver": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "supported",
        "takenOver"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "running",
    "apiReachable",
    "systemProxy"
  ],
  "additionalProperties": false
}
