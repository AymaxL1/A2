{
  "title": "UrlRouterExecutorReportParams",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "execution": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "enum": [
        "confirmed",
        "denied",
        "timeout",
        "error"
      ]
    },
    "perScheme": {
      "type": "object",
      "properties": {
        "http": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "error": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string",
                  "minLength": 1
                },
                "code": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "domain",
                "code",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "ok"
          ],
          "additionalProperties": false
        },
        "https": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "error": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string",
                  "minLength": 1
                },
                "code": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "domain",
                "code",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "ok"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "execution",
    "outcome",
    "perScheme"
  ],
  "additionalProperties": false
}
