{
  "title": "ConfirmationError",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "confirmation_unavailable",
        "confirmation_denied",
        "confirmation_timeout"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "detail": {
      "type": "string"
    },
    "guidance": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "description"
            ],
            "additionalProperties": false
          }
        },
        "context": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "summary",
        "steps"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "code",
    "message",
    "guidance"
  ],
  "additionalProperties": false
}
