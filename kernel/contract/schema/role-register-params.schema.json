{
  "title": "RoleRegisterParams",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "confirm-agent",
        "subscriber"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "codeDirectoryHash": {
          "type": "string",
          "minLength": 1
        },
        "teamIdentifier": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "role",
    "identity"
  ],
  "additionalProperties": false
}
