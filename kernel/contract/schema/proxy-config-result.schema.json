{
  "title": "ProxyConfigResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "settings": {
      "type": "object",
      "properties": {
        "mixedPort": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "allowLan": {
          "type": "boolean"
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "silent",
            "error",
            "warning",
            "info",
            "debug"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "rule",
            "global",
            "direct"
          ]
        }
      },
      "required": [
        "mixedPort",
        "allowLan",
        "logLevel",
        "mode"
      ],
      "additionalProperties": false
    },
    "configPath": {
      "type": "string",
      "minLength": 1
    },
    "controller": {
      "type": "string",
      "minLength": 1
    },
    "activeSubscription": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "inSync": {
      "type": "boolean"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "settings_written",
          "config_written",
          "config_reloaded"
        ]
      }
    }
  },
  "required": [
    "settings",
    "configPath",
    "controller",
    "activeSubscription",
    "inSync",
    "actions"
  ],
  "additionalProperties": false
}
