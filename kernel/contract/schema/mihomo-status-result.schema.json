{
  "title": "MihomoStatusResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "off",
        "observe",
        "embedded"
      ]
    },
    "embedded": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "running",
            "stopped",
            "failed"
          ]
        },
        "pid": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "binaryPath": {
          "type": "string",
          "minLength": 1
        },
        "binaryVersion": {
          "type": "string"
        },
        "lockedVersion": {
          "type": "string",
          "minLength": 1
        },
        "configPath": {
          "type": "string",
          "minLength": 1
        },
        "dataDir": {
          "type": "string",
          "minLength": 1
        },
        "controller": {
          "type": "string",
          "minLength": 1
        },
        "controllerReachable": {
          "type": "boolean"
        },
        "hasProxies": {
          "type": "boolean"
        },
        "restartCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lastError": {
          "type": "string"
        }
      },
      "required": [
        "state",
        "binaryPath",
        "lockedVersion",
        "configPath",
        "dataDir",
        "controller",
        "controllerReachable",
        "hasProxies",
        "restartCount"
      ],
      "additionalProperties": false
    },
    "foreign": {
      "type": "object",
      "properties": {
        "binary": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        },
        "instance": {
          "type": "object",
          "properties": {
            "controller": {
              "type": "string",
              "minLength": 1
            },
            "address": {
              "type": "string",
              "minLength": 1
            },
            "secretConfigured": {
              "type": "boolean"
            },
            "configFile": {
              "type": "string"
            },
            "reachable": {
              "type": "boolean"
            },
            "version": {
              "type": "string"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "rest_api",
                  "meta_core",
                  "configs_read"
                ]
              }
            }
          },
          "required": [
            "controller",
            "address",
            "secretConfigured",
            "reachable",
            "capabilities"
          ],
          "additionalProperties": false
        },
        "skippedController": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "legacyUnit": {
      "type": "boolean"
    },
    "guidance": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "description"
            ],
            "additionalProperties": false
          }
        },
        "context": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "summary",
        "steps"
      ],
      "additionalProperties": false
    },
    "home": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "mode",
    "embedded",
    "home"
  ],
  "additionalProperties": false
}
