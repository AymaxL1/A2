{
  "title": "UrlRouterHandler",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "http": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "https": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "matchesTarget": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "undetermined": {
      "type": "string"
    },
    "dangling": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scheme": {
            "type": "string",
            "enum": [
              "http",
              "https"
            ]
          },
          "bundleID": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "scheme",
          "bundleID"
        ],
        "additionalProperties": false
      }
    },
    "danglingFix": {
      "type": "string"
    }
  },
  "required": [
    "http",
    "https",
    "matchesTarget"
  ],
  "additionalProperties": false
}
