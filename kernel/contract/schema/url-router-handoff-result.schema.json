{
  "title": "UrlRouterHandoffResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target": {
      "type": "string",
      "minLength": 1
    },
    "already": {
      "type": "boolean"
    },
    "handler": {
      "type": "object",
      "properties": {
        "http": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "https": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "matchesTarget": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "undetermined": {
          "type": "string"
        },
        "dangling": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scheme": {
                "type": "string",
                "enum": [
                  "http",
                  "https"
                ]
              },
              "bundleID": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "scheme",
              "bundleID"
            ],
            "additionalProperties": false
          }
        },
        "danglingFix": {
          "type": "string"
        }
      },
      "required": [
        "http",
        "https",
        "matchesTarget"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "enum": [
        "already",
        "confirmed"
      ]
    },
    "perScheme": {
      "type": "object",
      "properties": {
        "http": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "error": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string",
                  "minLength": 1
                },
                "code": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "domain",
                "code",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "ok"
          ],
          "additionalProperties": false
        },
        "https": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "error": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string",
                  "minLength": 1
                },
                "code": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "domain",
                "code",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "ok"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "target",
    "already",
    "handler"
  ],
  "additionalProperties": false
}
