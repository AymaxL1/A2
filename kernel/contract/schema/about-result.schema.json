{
  "title": "AboutResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "product": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "type": "number",
      "const": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "externalPrograms": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "lockedVersion": {
            "type": "string",
            "minLength": 1
          },
          "bundled": {
            "type": "boolean",
            "const": false
          },
          "invocation": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "releases": {
            "type": "string",
            "minLength": 1
          },
          "licenseUrl": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "role",
          "license",
          "lockedVersion",
          "bundled",
          "invocation",
          "source",
          "releases",
          "licenseUrl"
        ],
        "additionalProperties": false
      }
    },
    "declaration": {
      "type": "string",
      "minLength": 1
    },
    "noticeFiles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "present": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "purpose",
          "path",
          "present"
        ],
        "additionalProperties": false
      }
    },
    "upgrade": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "product",
    "version",
    "protocol",
    "license",
    "externalPrograms",
    "declaration",
    "noticeFiles",
    "upgrade"
  ],
  "additionalProperties": false
}
