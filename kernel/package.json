{
  "name": "a2-kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "a2 内核（TS / Bun compile 单文件 bin）—— CLI 是唯一必需交互面，daemon 经 UDS 提供控制面",
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "bun test",
    "schema": "bun run src/contract/emit.ts",
    "typecheck": "bun x tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "typescript": "^5.9.3"
  }
}
