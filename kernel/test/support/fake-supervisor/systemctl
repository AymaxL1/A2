#!/bin/sh
# 假 systemctl --user —— **只给测试用**(Linux 实机验收顺延,spec「Linux 口径」)。同 launchctl 那份:
# `start`/`restart` **真的按 unit 里的 ExecStart 起一个真进程**,所以 install 之后 `a2 status` 真能连上。
#
# 行为面按 systemd 文档口径:
#   * `show` 恒 0 退出,unit 不在时 LoadState=not-found(**不是**报错);
#   * `enable` 只动开机自启开关,**不拉起进程**;拉起要另外 `start`;
#   * `restart` = 停掉旧进程再按**当前** unit 文件起一个新的(漂移收敛到进程、升级换版都靠它);
#   * `stop`/`disable` 对已停/已禁的 unit 也是 0(幂等)。
# 有意**不**模拟的:Restart=on-failure 自愈(归真 systemd)、ExecStart 里的引号词法(本仓库的临时路径无空格)。
#
# **状态与 unit 都按 unit 名分开**:$A2_FAKE_STATE_DIR/<unit>.state(内容 `<enabled> <pid>`)与
# $XDG_CONFIG_HOME/systemd/user/<unit>(由被测代码真写真删)。06 票起有两个 unit,不能再共用一份状态。
PATH=/usr/bin:/bin
set -u

printf 'systemctl %s\n' "$*" >> "$A2_FAKE_LOG"
STATE_DIR="$A2_FAKE_STATE_DIR"
mkdir -p "$STATE_DIR"

if [ "${1:-}" != "--user" ]; then
  printf 'fake systemctl 只接受 --user(内核不碰 system 域)\n' >&2
  exit 64
fi
shift
verb="${1:-}"

if [ "${A2_FAKE_FAIL:-}" = "$verb" ]; then
  printf 'Failed to %s unit: Access denied\n' "$verb" >&2
  exit 1
fi

if [ "$verb" = "daemon-reload" ]; then
  exit 0
fi

unit="${2:-}"
UNIT_FILE="$XDG_CONFIG_HOME/systemd/user/$unit"
STATE="$STATE_DIR/$unit.state"

enabled=0
pid=0
if [ -f "$STATE" ]; then
  enabled=$(cut -d' ' -f1 "$STATE")
  pid=$(cut -d' ' -f2 "$STATE")
fi
kill -0 "$pid" 2>/dev/null || pid=0

save() { printf '%s %s\n' "$1" "$2" > "$STATE"; }

# ExecStart 未加引号地展开成 argv(假件的已知简化);A2_HOME 从 Environment= 那行取(mihomo 的 unit 没有这一行)。
# exec 前的 sleep 与 launchctl 那份同理:如实模拟"报得出 pid 时还没 bind"的窗口。
spawn_from_unit() {
  a2home=$(sed -n 's/^Environment=A2_HOME=//p' "$UNIT_FILE")
  execstart=$(sed -n 's/^ExecStart=//p' "$UNIT_FILE")
  if [ -n "$a2home" ]; then
    (
      sleep "${A2_FAKE_START_DELAY:-0.3}"
      exec env A2_HOME="$a2home" $execstart
    ) >> "$A2_FAKE_LOG.daemon" 2>&1 < /dev/null &
  else
    (
      sleep "${A2_FAKE_START_DELAY:-0.3}"
      exec $execstart
    ) >> "$A2_FAKE_LOG.daemon" 2>&1 < /dev/null &
  fi
  printf '%s\n' "$!"
}

case "$verb" in
  show)
    if [ -f "$UNIT_FILE" ]; then
      printf 'LoadState=loaded\n'
      if [ "$enabled" = "1" ]; then printf 'UnitFileState=enabled\n'; else printf 'UnitFileState=disabled\n'; fi
      printf 'MainPID=%s\n' "$pid"
      if [ "$pid" != "0" ]; then printf 'ActiveState=active\n'; else printf 'ActiveState=inactive\n'; fi
    else
      printf 'LoadState=not-found\nUnitFileState=\nMainPID=0\nActiveState=inactive\n'
    fi
    exit 0
    ;;
  enable)
    if [ ! -f "$UNIT_FILE" ]; then
      printf 'Failed to enable unit: Unit file %s does not exist.\n' "$UNIT_FILE" >&2
      exit 1
    fi
    save 1 "$pid"
    exit 0
    ;;
  disable)
    save 0 "$pid"
    exit 0
    ;;
  start)
    if [ ! -f "$UNIT_FILE" ]; then
      printf 'Failed to start unit: Unit not found.\n' >&2
      exit 5
    fi
    if [ "$pid" = "0" ]; then pid="$(spawn_from_unit)"; fi
    save "$enabled" "$pid"
    exit 0
    ;;
  restart)
    if [ ! -f "$UNIT_FILE" ]; then
      printf 'Failed to restart unit: Unit not found.\n' >&2
      exit 5
    fi
    [ "$pid" = "0" ] || kill "$pid" 2>/dev/null
    pid="$(spawn_from_unit)"
    save "$enabled" "$pid"
    exit 0
    ;;
  stop)
    [ "$pid" = "0" ] || kill "$pid" 2>/dev/null
    save "$enabled" 0
    exit 0
    ;;
esac

printf 'Unknown verb: %s\n' "$verb" >&2
exit 64
